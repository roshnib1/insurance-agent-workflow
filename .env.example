# Model provider (see workflow/model_config.py)
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
# Prefer models with solid tool/function calling. Gemma often emits
# malformed tool-argument JSON and crashes ADK's LiteLLM parser.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Alternative: Groq
# MODEL_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key

# Alternative: Gemini
# MODEL_PROVIDER=gemini
# GOOGLE_API_KEY=your-google-api-key

# Operational Assurance SDK (v2 workflow only; optional)
# Install the SDK (from the sdk-gateway repo if not on PyPI):
#   pip install -e "/path/to/sdk-gateway/sdk[adk]"
# Register the producer with all ADK_EVENT_TYPES before the first run.
# See how-to-use-sdk.md for producer registration and gateway setup.
ASSURANCE_GATEWAY_URL=http://127.0.0.1:8000
ASSURANCE_API_KEY=test-commercial-property-underwriting-key
ASSURANCE_PRODUCER_ID=commercial-property-underwriting
ASSURANCE_TENANT_ID=default-tenant
ASSURANCE_CAPTURE_MODE=metadata_only
ASSURANCE_PRODUCER_VERSION=0.2.0
# ASSURANCE_DISABLED=1
