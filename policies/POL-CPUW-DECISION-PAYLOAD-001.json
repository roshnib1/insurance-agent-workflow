{
  "policy_id": "POL-CPUW-DECISION-PAYLOAD-001",
  "tenant_id": "default-tenant",
  "name": "Approve-path decision must match underwriting payload controls",
  "description": "Commercial Property Underwriting (property-underwriting graph) payload-aware control: on finalize_decision completion, require prior FunctionNode routes that prove submission completeness, approved CAT path, Approve underwriter action, and finalize status/mode. Gate nodes return Event(route=...); CAT/PII facts are asserted on the finalize decision payload (cat_exposure).",
  "policy_category": "underwriting",
  "created_by": "governance-team",
  "compliance_sentence": "When finalize_decision Completes, the workflow must already show submission_intake_step(result.route=complete), cat_exposure_step(result.route=approved), human_underwriter_step(result.route=approve), and finalize status=COMPLETED with AUTONOMOUS mode plus cat_exposure evidence on the decision.",
  "rule_definition_json": {
    "subject": {
      "type": "tool",
      "selector": {
        "tool_name": "finalize_decision",
        "capability": "underwriting_decision",
        "risk_class": "high"
      }
    },
    "trigger": {
      "event_type": "TOOL_CALL_COMPLETED"
    },
    "assertions": [
      {
        "assertion_id": "finalize-status-completed",
        "type": "event_exists",
        "event_type": "TOOL_CALL_COMPLETED",
        "where": {
          "tool_name": "finalize_decision",
          "status": "success",
          "tool_args.status": "COMPLETED",
          "result.status": "COMPLETED"
        }
      },
      {
        "assertion_id": "submission-route-complete",
        "type": "event_exists",
        "event_type": "TOOL_CALL_COMPLETED",
        "where": {
          "tool_name": "submission_intake_step",
          "status": "success",
          "result.route": "complete"
        }
      },
      {
        "assertion_id": "cat-exposure-route-approved",
        "type": "event_exists",
        "event_type": "TOOL_CALL_COMPLETED",
        "where": {
          "tool_name": "cat_exposure_step",
          "status": "success",
          "result.route": "approved"
        }
      },
      {
        "assertion_id": "finalize-cat-low-scored",
        "type": "event_exists",
        "event_type": "TOOL_CALL_COMPLETED",
        "where": {
          "tool_name": "finalize_decision",
          "status": "success",
          "result.cat_exposure.cat_category": "LOW",
          "result.cat_exposure.cat_score": 20,
          "result.cat_exposure.vendor_approved": true,
          "result.cat_exposure.pii_redacted": true
        }
      },
      {
        "assertion_id": "underwriter-route-approve",
        "type": "event_exists",
        "event_type": "TOOL_CALL_COMPLETED",
        "where": {
          "tool_name": "human_underwriter_step",
          "status": "success",
          "result.route": "approve"
        }
      },
      {
        "assertion_id": "finalize-decision-mode-present",
        "type": "event_exists",
        "event_type": "TOOL_CALL_COMPLETED",
        "where": {
          "tool_name": "finalize_decision",
          "status": "success",
          "tool_args.decision_mode": "AUTONOMOUS",
          "result.decision_mode": "AUTONOMOUS",
          "result.decision_maker": "AI"
        }
      },
      {
        "assertion_id": "no-finalize-failure",
        "type": "event_absence",
        "event_type": "TOOL_CALL_FAILED",
        "where": {
          "tool_name": "finalize_decision"
        }
      }
    ],
    "enforcement": {
      "mode": "observe",
      "failure_action": "record_finding"
    }
  },
  "assignment": {
    "workflow_type": "commercial_property_underwriting:proposal",
    "business_object_type": "proposal",
    "environment": "test",
    "priority": 90
  },
  "notes": [
    "Requires gateway _match_where dotted-path support for payload.result.* and payload.tool_args.*.",
    "Gate FunctionNodes emit Event(route=...) — business fields live on finalize_decision.result.",
    "cat_score/cat_category and AUTONOMOUS decision_mode are tight to the low-risk approve path; loosen before warn/block on other scenarios."
  ]
}
